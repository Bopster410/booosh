#!/usr/bin/env bash
# Optional terminal setups ("packs") on top of the core install.
# A pack only drops files into places the tools already read:
#   fish   ~/.config/fish/{conf.d,functions,completions,themes}/ (the layout fisher uses), plus conf.d/pack-<name>.fish
#   git    ~/.config/git/pack-<name>[-<tool>].conf, pulled in by one include.path line
# Removing a pack removes exactly those files again. Core config is never edited.
#
#   ./pack list                  packs: installed ones and those of the catalog (downloaded when needed)
#   ./pack show git              files, parts, tools and abbreviations (also for a source you have not installed yet)
#   ./pack add git [docker ...]  install packs (a pack that is not shipped here is downloaded from the catalog)
#   ./pack add git --tag --delta ... with some of its options: optional parts and optional tools alike (see ./pack show git)
#                                    in a terminal, ./pack add git offers them in one checklist
#   ./pack add OWNER/REPO[@REF]  install a fish plugin from GitHub, fisher style; also github:OWNER/REPO, https://...tar.gz, ./folder
#   ./pack update [NAME ...]     download again and re-apply (every installed pack when no name is given)
#   ./pack remove git [--tag]    unlink the pack, or switch off one option; a program that pack itself installed is offered
#                                    for uninstalling (--purge-tools: yes, --keep-tools: no), any other program is never touched
#   ./pack status                health check of installed packs
# Flags: --dry-run  --yes (accept git-setting conflicts, and "install code from this source")  --all (every option)
#        --none (no option, no question)  --with-tools / --no-tools (all / none of the tools)  --ask (also ask without a terminal)
#        --purge-tools / --keep-tools (on remove: uninstall / keep the programs pack installed)
#        --remote (when a packs/ folder sits next to this script, ignore it and use the catalog)
# Works with bash 3.2 (macOS system bash).
set -euo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKS="$SRC/packs"
CFG="$HOME/.config"
STATE="$CFG/boosh/packs"
FISH_DIR="$CFG/fish/conf.d"
GIT_DIR="$CFG/git"

die() { echo "error: $*" >&2; exit 1; }

# shellcheck source=lib/menu.sh
. "$SRC/lib/menu.sh"
# shellcheck source=lib/state.sh
. "$SRC/lib/state.sh"
# shellcheck source=lib/source.sh
. "$SRC/lib/source.sh"
PACK_API=1   # the pack format this tool understands (a pack may say API=N in pack.conf)

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

DRY=0; YES=0; ASK=0; REMOTE=0; OPT_ALL=0; OPT_NONE=0; OPT_TOOLS=; OPT_PURGE=0; OPT_KEEP=0
POS=()
EXTRAS=()   # --NAME that is not a flag of this tool: an option of a pack, a part or a tool (./pack add git --tag --delta)
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)    DRY=1 ;;
    --yes|-y)     YES=1 ;;
    --ask)        ASK=1 ;;
    --remote)     REMOTE=1 ;;
    --all)        OPT_ALL=1 ;;
    --none)       OPT_NONE=1 ;;
    --with-tools) OPT_TOOLS=all ;;
    --no-tools)   OPT_TOOLS=none ;;
    --purge-tools) OPT_PURGE=1 ;;
    --keep-tools) OPT_KEEP=1 ;;
    -h|--help)    usage; exit 0 ;;
    --?*)         EXTRAS+=("${1#--}") ;;   # checked against the named packs below
    -*)           usage >&2; die "unknown option: $1" ;;
    *)            POS+=("$1") ;;
  esac
  shift
done
[ ${#POS[@]} -gt 0 ] || { usage; exit 0; }
[ "$OPT_PURGE$OPT_KEEP" != 11 ] || die "--purge-tools and --keep-tools contradict each other"
CMD="${POS[0]}"
NAMES=()
if [ ${#POS[@]} -gt 1 ]; then NAMES=("${POS[@]:1}"); fi

# ─── helpers ─────────────────────────────────────────────
TMPS=()
cleanup() { local t; if [ ${#TMPS[@]} -gt 0 ]; then for t in "${TMPS[@]}"; do rm -rf "$t"; done; fi; return 0; }
trap cleanup EXIT

run() { if [ "$DRY" = 1 ]; then echo "would run: $*"; else "$@"; fi; }

confirm() { # confirm "question" [y|n]   (non-interactive: the default)
  local q="$1" def="${2:-n}" ans hint="y/N" pick
  [ "$def" = y ] && hint="Y/n"
  if menu_ok; then   # real terminal: arrow-key yes/no
    select_menu pick "$q" "$([ "$def" = y ] && echo yes || echo no)" yes no
    [ "$pick" = yes ]; return
  fi
  if [ "$ASK" != 1 ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then [ "$def" = y ]; return; fi
  printf '%s [%s]: ' "$q" "$hint"
  read -r ans || ans=""
  ans="${ans:-$def}"
  case "$ans" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

backup() { # never overwrites an older backup; remembered in the manifest
  local dst="$1" b n=1
  b="$dst.bak"
  while [ -e "$b" ] || [ -L "$b" ]; do b="$dst.bak.$n"; n=$((n + 1)); done
  if [ "$DRY" = 1 ]; then echo "would back up $dst -> $b"; else mv "$dst" "$b"; echo "backup  $dst -> $b"; mf_add backup "$dst" "$b"; fi
}

link() { # link TARGET LIVE : LIVE becomes a symlink to TARGET (a file inside the pack's snapshot)
  local target="$1" live="$2" cur=""
  if [ -L "$live" ] && [ "$(readlink "$live")" = "$target" ]; then
    echo "ok      $live"; [ "$DRY" = 1 ] || mf_add link "$live" "$target" packs; return 0
  fi
  [ ! -L "$live" ] || cur="$(readlink "$live")"
  case "$cur" in
    "$PACKS"/*|"$BOOSH_HOME"/*)   # a link boosh made earlier (into the repository): replace it, nothing to back up
      if [ "$DRY" = 1 ]; then echo "would relink $live -> $target"; return 0; fi
      rm "$live" ;;
  esac
  if [ -e "$live" ] || [ -L "$live" ]; then backup "$live"; fi
  if [ "$DRY" = 1 ]; then echo "would link $live -> $target"; return 0; fi
  mkdir -p "$(dirname "$live")"
  ln -s "$target" "$live"; echo "link    $live -> $target"; mf_add link "$live" "$target" packs
}

unlink_ours() { # unlink_ours TARGET PACKNAME : only removes symlinks that point into this pack (its snapshot or the repository)
  local dst="$1" name="$2"
  [ -L "$dst" ] || { [ ! -e "$dst" ] || echo "skip    $dst is not a symlink, left alone"; return 0; }
  case "$(readlink "$dst")" in
    "$BH_PACKS/$name/"*|"$PACKS/$name/"*) if [ "$DRY" = 1 ]; then echo "would remove $dst"; else rm "$dst"; echo "removed $dst"; fi ;;
    *) echo "skip    $dst points elsewhere, left alone" ;;
  esac
}

# a pack is known if it is in this repository or already installed (its snapshot): so `remove` and `status` keep
# working after a branch switch
PK_NAME=""; PK_DIR=""   # the pack being added or shown right now, and the folder it is read from (a download, the catalog, this repository)
pdir() {
  if [ -n "$PK_NAME" ] && [ "$1" = "$PK_NAME" ]; then echo "$PK_DIR"
  elif [ -f "$BH_PACKS/$1/pack.conf" ]; then echo "$BH_PACKS/$1"
  elif [ "$REMOTE" != 1 ] && [ -f "$PACKS/$1/pack.conf" ]; then echo "$PACKS/$1"
  elif [ -n "$CATALOG_DIR" ] && [ -f "$CATALOG_DIR/$1/pack.conf" ]; then echo "$CATALOG_DIR/$1"
  else echo "$PACKS/$1"; fi
}
valid_name() {
  case "$1" in ''|*[!a-z0-9_-]*) return 1 ;; esac
  [ -f "$BH_PACKS/$1/pack.conf" ] || [ -f "$PACKS/$1/pack.conf" ] || { [ -n "$CATALOG_DIR" ] && [ -f "$CATALOG_DIR/$1/pack.conf" ]; }
}
need_pack() { valid_name "$1" || die "no such pack: '$1' (see: ./pack list)"; }

# The options of a pack are of two kinds, and are chosen the same way (a flag, or one checklist):
#   part  an optional folder of the pack: extras/NAME/{extra.conf,functions/,completions/,fish.fish}
#   tool  an optional program: a TOOL=cmd|brew package|apt package|description line of pack.conf (the option is called cmd)
extras_of()  { local d; for d in "$(pdir "$1")"/extras/*/; do if [ -f "${d}extra.conf" ]; then basename "$d"; fi; done; }
is_extra()   { [ -f "$(pdir "$1")/extras/$2/extra.conf" ]; }
extra_desc() { sed -n 's/^DESCRIPTION=//p' "$(pdir "$1")/extras/$2/extra.conf" | head -n 1; }
tool_spec()  { # tool_spec PACK CMD -> its TOOL= line (without "TOOL=")
  local t
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    if [ "$(field "$t" 1)" = "$2" ]; then echo "$t"; return 0; fi
  done <<EOF
$(conf_tools "$1")
EOF
  return 1
}
tools_of()   { local t; while IFS= read -r t; do if [ -n "$t" ]; then field "$t" 1; fi; done <<EOF
$(conf_tools "$1")
EOF
}
is_tool()    { tool_spec "$1" "$2" >/dev/null; }
is_option()  { is_extra "$1" "$2" || is_tool "$1" "$2"; }
options_of() { extras_of "$1"; tools_of "$1"; }
opt_kind()   { if is_extra "$1" "$2"; then echo part; else echo tool; fi; }
opt_desc()   { if is_extra "$1" "$2"; then extra_desc "$1" "$2"; else field "$(tool_spec "$1" "$2")" 4; fi; }
opt_state()  { # installed (a part is linked, a tool is found on PATH), not installed, or off (a tool switched off for this pack)
  if is_extra "$1" "$2"; then if is_installed "$1+$2"; then echo installed; else echo "not installed"; fi
  elif is_installed "$1~$2"; then echo off
  elif have_cmd "$2"; then echo installed
  else echo "not installed"; fi
}
requested()  { local x; [ ${#EXTRAS[@]} -gt 0 ] || return 1; for x in "${EXTRAS[@]}"; do if [ "$x" = "$1" ]; then return 0; fi; done; return 1; }
CHOSEN=""   # the options this run sets up (decided by choose_options)
chosen()     { case " $CHOSEN " in *" $1 "*) return 0 ;; esac; return 1; }
check_parts() { # check_parts PACK... : every --OPTION you gave must exist in every named pack
  local n x
  [ ${#EXTRAS[@]} -gt 0 ] || return 0
  for n in "$@"; do
    need_pack "$n"
    for x in "${EXTRAS[@]}"; do
      is_option "$n" "$x" || die "'--$x' is not a flag, and pack '$n' has no option '$x' (see: ./pack show $n)"
    done
  done
}

conf_get()   { [ -f "$(pdir "$1")/pack.conf" ] || return 0; sed -n "s/^$2=//p" "$(pdir "$1")/pack.conf" | head -n 1; }
conf_tools() { [ -f "$(pdir "$1")/pack.conf" ] || return 0; sed -n 's/^TOOL=//p' "$(pdir "$1")/pack.conf"; }
meta_get()   { [ -f "$BH_PACKS/$1/.source" ] || return 0; sed -n "s/^$2=//p" "$BH_PACKS/$1/.source" | head -n 1; }   # provenance of an installed pack
field()      { echo "$1" | cut -d'|' -f"$2"; }

is_installed() { [ -f "$STATE" ] && grep -Fxq "$1" "$STATE"; }
state_add() {
  [ "$DRY" = 1 ] && return 0
  mkdir -p "$(dirname "$STATE")"; is_installed "$1" || echo "$1" >> "$STATE"
}
state_del() {
  [ "$DRY" = 1 ] && return 0
  [ -f "$STATE" ] || return 0
  grep -Fxv "$1" "$STATE" > "$STATE.tmp" || true
  mv "$STATE.tmp" "$STATE"
}

have_cmd() { command -v "$1" >/dev/null 2>&1; }

BREW_CANDIDATES="${BOOSH_BREW_CANDIDATES-/home/linuxbrew/.linuxbrew/bin/brew /opt/homebrew/bin/brew /usr/local/bin/brew}"
brew_bin() { # Homebrew: on PATH, else at one of its usual places (it is often installed but not on PATH)
  local b
  if have_cmd brew; then command -v brew; return 0; fi
  for b in $BREW_CANDIDATES; do
    if [ -x "$b" ]; then echo "$b"; return 0; fi
  done
  return 1
}

# ─── optional tools ──────────────────────────────────────
# The package manager is found, not configured: Homebrew first (when there is a brew package for the tool), else apt
# (when apt has the package), else nothing and you are told why. The commands are built from the TOOL= line.
pick_manager() { # pick_manager BREWPKG APTPKG : sets PM (brew|apt|empty), PM_BIN, PM_PKG and, when empty, PM_WHY
  local brewpkg="$1" aptpkg="$2" brew
  PM=""; PM_BIN=""; PM_PKG=""; PM_WHY=""
  brew="$(brew_bin || true)"
  if [ -n "$brew" ] && [ -n "$brewpkg" ]; then PM=brew; PM_BIN="$brew"; PM_PKG="$brewpkg"; return 0; fi
  if [ -n "$aptpkg" ] && have_cmd apt-get && apt-cache show "$aptpkg" >/dev/null 2>&1; then PM=apt; PM_PKG="$aptpkg"; return 0; fi
  if [ -z "$brew" ] && ! have_cmd apt-get; then
    PM_WHY="no package manager found (pack knows Homebrew and apt). Install Homebrew (https://brew.sh) or the program itself"
  elif [ -z "$brew" ] && [ -n "$brewpkg" ] && [ -z "$aptpkg" ]; then
    PM_WHY="it is packaged only for Homebrew, and Homebrew is not installed (https://brew.sh)"
  elif [ -z "$brew" ] && [ -n "$brewpkg" ]; then
    PM_WHY="Homebrew is not installed (https://brew.sh), and apt has no package '$aptpkg'"
  else
    PM_WHY="no package for it in the package managers found here"
  fi
  return 1
}

tool_via() { # tool_via SPEC -> a short phrase: how this tool would be installed here
  local spec="$1"
  if pick_manager "$(field "$spec" 2)" "$(field "$spec" 3)"; then echo "via $PM"; else echo "not installable here: $PM_WHY"; fi
}

# Programs that pack itself installed (and so may offer to uninstall): pack<TAB>cmd<TAB>manager<TAB>package<TAB>brew path.
# A program that was already on the machine is never in this log, so it is never touched.
TOOLS_LOG="$CFG/boosh/tools"
tool_log_get()  { [ -f "$TOOLS_LOG" ] || return 0; awk -F'\t' -v p="$1" -v c="$2" '$1 == p && $2 == c { print; exit }' "$TOOLS_LOG"; }
tool_log_cmds() { [ -f "$TOOLS_LOG" ] || return 0; awk -F'\t' -v p="$1" '$1 == p { print $2 }' "$TOOLS_LOG"; }
tool_log_drop() {
  if [ "$DRY" = 1 ] || [ ! -f "$TOOLS_LOG" ]; then return 0; fi
  awk -F'\t' -v p="$1" -v c="$2" '!($1 == p && $2 == c)' "$TOOLS_LOG" > "$TOOLS_LOG.tmp" && mv "$TOOLS_LOG.tmp" "$TOOLS_LOG"
  return 0
}
tool_log_add() { # tool_log_add PACK CMD MANAGER PACKAGE BREWBIN
  if [ "$DRY" = 1 ]; then return 0; fi
  mkdir -p "$(dirname "$TOOLS_LOG")"
  tool_log_drop "$1" "$2"
  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "${5:-}" >> "$TOOLS_LOG"
}
tool_log_move() { # tool_log_move FROM_PACK CMD TO_PACK : another pack that uses the program takes over the right to remove it
  local line mgr pkg bin
  line="$(tool_log_get "$1" "$2")"
  [ -n "$line" ] || return 0
  IFS=$'\t' read -r _ _ mgr pkg bin <<EOF
$line
EOF
  tool_log_drop "$1" "$2"
  tool_log_add "$3" "$2" "$mgr" "$pkg" "$bin"
}

ensure_tool() { # ensure_tool "cmd|brewpkg|aptpkg|description" : install a tool that was chosen (and is missing)
  local spec="$1" cmd brewpkg aptpkg desc
  cmd="$(field "$spec" 1)"; brewpkg="$(field "$spec" 2)"; aptpkg="$(field "$spec" 3)"; desc="$(field "$spec" 4)"
  if have_cmd "$cmd"; then echo "have    $cmd (already installed)"; return 0; fi
  if ! pick_manager "$brewpkg" "$aptpkg"; then
    echo "warn    $cmd is not installed and cannot be: $PM_WHY."
    echo "        Install it yourself ($desc), then run './pack add ${PK_NAME:-PACK}' again."
    return 0
  fi
  case "$PM" in
    brew)
      echo "install $cmd via Homebrew ($PM_PKG)"
      run "$PM_BIN" install "$PM_PKG" || { echo "warn    brew could not install $PM_PKG"; return 0; }
      tool_log_add "${PK_NAME:-}" "$cmd" brew "$PM_PKG" "$PM_BIN" ;;
    apt)
      if [ "$(id -u)" -eq 0 ]; then
        echo "install $cmd via apt ($PM_PKG)"; run apt-get install -y "$PM_PKG" || { echo "warn    apt could not install $PM_PKG"; return 0; }
      elif have_cmd sudo; then
        echo "install $cmd via apt ($PM_PKG), sudo will ask for your password"; run sudo apt-get install -y "$PM_PKG" || { echo "warn    apt could not install $PM_PKG"; return 0; }
      else
        echo "warn    $cmd needs apt, which needs root, and sudo is not installed: run  apt-get install $PM_PKG  as root"
        return 0
      fi
      tool_log_add "${PK_NAME:-}" "$cmd" apt "$PM_PKG" "" ;;
  esac
  if [ "$DRY" = 0 ] && ! have_cmd "$cmd"; then
    echo "warn    $cmd was installed but is not on PATH."
    if [ "$PM" = brew ]; then echo "        Put Homebrew on PATH: in fish  fish_add_path $(dirname "$PM_BIN")  (for bash/zsh: eval \"\$($PM_BIN shellenv)\")"; fi
    echo "        Config that needs $cmd stays off until it is found; run './pack add ${PK_NAME:-PACK}' again afterwards."
  fi
  return 0
}

# ─── git config include ──────────────────────────────────
git_ok() { have_cmd git; }

git_conflicts() { # print keys the user already set to a different value in the global git config
  local file="$1" key val cur
  while IFS='=' read -r key val; do
    [ -n "$key" ] || continue
    cur="$(git config --global --get "$key" 2>/dev/null || true)"
    if [ -n "$cur" ] && [ "$cur" != "$val" ]; then echo "  $key: yours=$cur, pack=$val"; fi
  done < <(git config -f "$file" --list)
}

git_include_has() { git config --global --get-all include.path 2>/dev/null | grep -Fxq "$1"; }

git_attach() { # git_attach SOURCE_FILE LINK_NAME (without dir)
  local src="$1" name="$2" dst="$GIT_DIR/$2" inc="~/.config/git/$2" c
  c="$(git_conflicts "$src")"
  if [ -n "$c" ]; then
    echo "Your global git config already sets different values for:"
    echo "$c"
    echo "The include is appended last, so the pack's values would win."
    if [ "$YES" = 1 ] || confirm "Continue and let the pack override these?" n; then :; else
      echo "skip    $name (nothing changed for this file)"; return 0
    fi
  fi
  link "$src" "$dst"
  if git_include_has "$inc"; then echo "ok      include.path $inc"
  else run git config --global --add include.path "$inc"; [ "$DRY" = 1 ] || echo "git     include.path $inc"; fi
}

git_detach() { # git_detach LINK_NAME PACKNAME
  local name="$1" pack="$2" inc="~/.config/git/$1"
  if git_ok && git_include_has "$inc"; then
    run git config --global --fixed-value --unset-all include.path "$inc" \
      || echo "warn    could not remove include.path $inc; remove that line from ~/.gitconfig by hand"
    [ "$DRY" = 1 ] || echo "git     include.path $inc removed"
  fi
  unlink_ours "$GIT_DIR/$name" "$pack"
}

# ─── uninstalling what pack installed ───────────────────
tool_present() { # tool_present CMD MANAGER PACKAGE BREWBIN : is the program still installed (Homebrew may keep it off PATH)?
  if have_cmd "$1"; then return 0; fi
  if [ "$2" = brew ] && [ -n "${4:-}" ] && [ -x "$4" ]; then [ -n "$("$4" list --versions "$3" 2>/dev/null)" ]; return; fi
  return 1
}

tool_used_elsewhere() { # tool_used_elsewhere PACK CMD -> another installed pack that chose this tool (prints its name)
  local other
  if [ ! -f "$STATE" ]; then return 0; fi
  while IFS= read -r other; do
    case "$other" in ''|*+*|*~*) continue ;; esac
    [ "$other" != "$1" ] || continue
    if is_installed "$other+$2" && is_tool "$other" "$2"; then echo "$other"; return 0; fi
  done < "$STATE"
  return 0
}

remove_tools() { # remove_tools PACK [CMD ...] : offer to uninstall the programs this pack installed (all of them, or the named ones)
  local pack="$1" cmds c line mgr pkg bin other yes
  shift
  if [ $# -gt 0 ]; then cmds="$*"; else cmds="$(tool_log_cmds "$pack")"; fi
  for c in $cmds; do
    line="$(tool_log_get "$pack" "$c")"
    [ -n "$line" ] || continue   # not installed by this pack: never touched
    IFS=$'\t' read -r _ _ mgr pkg bin <<EOF
$line
EOF
    if ! tool_present "$c" "$mgr" "$pkg" "$bin"; then tool_log_drop "$pack" "$c"; continue; fi   # already gone
    other="$(tool_used_elsewhere "$pack" "$c")"
    if [ -n "$other" ]; then
      echo "keep    $c: the pack '$other' uses it too (it can offer to remove it when you remove that pack)"
      tool_log_move "$pack" "$c" "$other"
      continue
    fi
    yes=0
    if [ "$OPT_PURGE" = 1 ]; then yes=1
    elif [ "$OPT_KEEP" = 1 ]; then yes=0
    elif confirm "Also uninstall $c? Pack '$pack' installed it with $mgr ($pkg)." n; then yes=1; fi
    if [ "$yes" = 0 ]; then
      echo "keep    $c (to remove it later: $( [ "$mgr" = brew ] && echo "brew uninstall $pkg" || echo "sudo apt-get remove $pkg" )$( is_installed "$pack" && echo ", or ./pack remove $pack --purge-tools" ))"
      continue
    fi
    case "$mgr" in
      brew)
        [ -x "$bin" ] || bin="$(brew_bin || true)"
        if [ -z "$bin" ]; then echo "warn    Homebrew was not found: run  brew uninstall $pkg  yourself"; continue; fi
        if run "$bin" uninstall "$pkg"; then tool_log_drop "$pack" "$c"; echo "removed $c (brew $pkg)"; else echo "warn    brew could not uninstall $pkg"; fi ;;
      apt)
        if [ "$(id -u)" -eq 0 ]; then
          if run apt-get remove -y "$pkg"; then tool_log_drop "$pack" "$c"; echo "removed $c (apt $pkg)"; else echo "warn    apt could not remove $pkg"; fi
        elif have_cmd sudo; then
          echo "sudo will ask for your password to remove $pkg"
          if run sudo apt-get remove -y "$pkg"; then tool_log_drop "$pack" "$c"; echo "removed $c (apt $pkg)"; else echo "warn    apt could not remove $pkg"; fi
        else
          echo "warn    removing $pkg needs root and sudo is not installed: run  apt-get remove $pkg  as root"
        fi ;;
    esac
  done
  return 0
}

# ─── choosing the options of a pack ─────────────────────
MENU_PACK=""
menu_desc() { # description in the checklist: what the option is, and for a tool how it would be installed
  local o="$2" d
  if is_extra "$MENU_PACK" "$o"; then extra_desc "$MENU_PACK" "$o"
  else d="$(tool_spec "$MENU_PACK" "$o")"; echo "$(field "$d" 4)  [tool, $(tool_via "$d")]"; fi
}

choose_options() { # choose_options NAME : sets CHOSEN, the options to set up in this run
  local name="$1" o todo="" typed any_flag=0
  CHOSEN=""
  # what was chosen before stays chosen (parts installed, tools asked for)
  for o in $(options_of "$name"); do
    if is_installed "$name+$o"; then CHOSEN="$CHOSEN $o"; fi
  done
  if [ ${#EXTRAS[@]} -gt 0 ]; then
    any_flag=1
    for o in "${EXTRAS[@]}"; do CHOSEN="$CHOSEN $o"; done
  fi
  if [ "$OPT_ALL" = 1 ]; then any_flag=1; for o in $(options_of "$name"); do CHOSEN="$CHOSEN $o"; done; fi
  if [ "$OPT_TOOLS" = all ]; then any_flag=1; for o in $(tools_of "$name"); do CHOSEN="$CHOSEN $o"; done; fi
  if [ "$OPT_NONE" = 1 ] || [ "$OPT_TOOLS" = none ]; then any_flag=1; fi
  [ "$any_flag" = 0 ] || return 0
  # nothing said: offer what is not on yet (a part not installed, a tool that is neither chosen nor already on this machine)
  for o in $(options_of "$name"); do
    if chosen "$o"; then continue; fi
    if is_tool "$name" "$o" && have_cmd "$o"; then continue; fi
    todo="$todo $o"
  done
  todo="${todo# }"
  [ -n "$todo" ] || return 0
  MENU_PACK="$name"
  if menu_ok; then
    select_multi typed "Optional for $name:" "" $todo
    CHOSEN="$CHOSEN $typed"
  elif [ "$ASK" = 1 ]; then
    echo "Optional for $name: $todo"
    printf 'Type the ones you want (space separated, all, or empty for none): '
    read -r typed || typed=""
    if [ "$typed" = all ]; then typed="$todo"; fi
    for o in $typed; do
      case " $todo " in *" $o "*) CHOSEN="$CHOSEN $o" ;; *) echo "skip    '$o' is not an option of $name" ;; esac
    done
  fi
  return 0
}

# ─── fish files of a pack or of one of its parts (the layout fisher plugins use) ─────
pack_fish_files() { # pack_fish_files DIR : "SUBFOLDER<TAB>FILE" for every file that goes into ~/.config/fish/
  local d="$1" sub f
  for sub in functions completions conf.d; do
    for f in "$d/$sub"/*.fish; do
      [ -f "$f" ] || continue
      printf '%s\t%s\n' "$sub" "$f"
    done
  done
  for f in "$d/themes"/*.theme; do
    [ -f "$f" ] || continue
    printf 'themes\t%s\n' "$f"
  done
  return 0
}

live_paths_of() { # live_paths_of DIR SNIPPET : where this pack (or part) would put its files
  local d="$1" snip="$2" sub f
  [ ! -f "$d/fish.fish" ] || echo "$FISH_DIR/$snip.fish"
  while IFS=$'\t' read -r sub f; do
    echo "$CFG/fish/$sub/$(basename "$f")"
  done < <(pack_fish_files "$d")
  return 0
}

link_fish_dir() { # link_fish_dir DIR SNIPPET : DIR/fish.fish -> conf.d/SNIPPET.fish, the rest by name into ~/.config/fish/<folder>/
  local d="$1" snip="$2" sub f
  [ ! -f "$d/fish.fish" ] || link "$d/fish.fish" "$FISH_DIR/$snip.fish"
  while IFS=$'\t' read -r sub f; do
    link "$f" "$CFG/fish/$sub/$(basename "$f")"
  done < <(pack_fish_files "$d")
  return 0
}

unlink_fish_dir() { # unlink_fish_dir DIR SNIPPET PACK
  local d="$1" snip="$2" pack="$3" sub f
  if [ -f "$d/fish.fish" ]; then unlink_ours "$FISH_DIR/$snip.fish" "$pack"; [ "$DRY" = 1 ] || mf_drop_live "$FISH_DIR/$snip.fish"; fi
  while IFS=$'\t' read -r sub f; do
    unlink_ours "$CFG/fish/$sub/$(basename "$f")" "$pack"
    [ "$DRY" = 1 ] || mf_drop_live "$CFG/fish/$sub/$(basename "$f")"
  done < <(pack_fish_files "$d")
  return 0
}

list_fish_dir() { # list_fish_dir DIR SNIPPET INDENT
  local d="$1" snip="$2" ind="$3" sub f
  [ ! -f "$d/fish.fish" ] || echo "${ind}fish   $FISH_DIR/$snip.fish"
  while IFS=$'\t' read -r sub f; do
    echo "${ind}fish   $CFG/fish/$sub/$(basename "$f")"
  done < <(pack_fish_files "$d")
  return 0
}

check_fish_dir() { # check_fish_dir DIR SNIPPET PACK : prints a WARN line per problem, fails if there was one
  local d="$1" snip="$2" name="$3" sub f live bad=0
  if [ -f "$d/fish.fish" ]; then
    live="$FISH_DIR/$snip.fish"
    if [ ! -L "$live" ]; then echo "WARN  $name: $live is missing (run: ./pack add $name)"; bad=1
    elif [ ! -e "$live" ]; then echo "WARN  $name: $live is a BROKEN link (run: ./pack add $name)"; bad=1; fi
  fi
  while IFS=$'\t' read -r sub f; do
    live="$CFG/fish/$sub/$(basename "$f")"
    if [ ! -L "$live" ] || [ ! -e "$live" ]; then echo "WARN  $name: $live is missing or broken (run: ./pack add $name)"; bad=1; fi
  done < <(pack_fish_files "$d")
  [ "$bad" = 0 ]
}

# two packs (or a pack and the boosh prompt) must never fight over one file: stop before anything is changed
preflight() { # preflight NAME SRCDIR
  local name="$1" d="$2" x paths p own bad=""
  paths="$( live_paths_of "$d" "pack-$name"
            for x in $(extras_of "$name"); do
              if chosen "$x"; then live_paths_of "$d/extras/$x" "pack-$name-$x"; fi
            done )"
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    own="$(mf_owner_of "$p")"
    if [ -n "$own" ] && [ "$own" != "pack:$name" ]; then bad="$bad
  $p  (belongs to $own)"; fi
  done <<EOF
$paths
EOF
  [ -z "$bad" ] || die "cannot install '$name': these files already belong to something else:$bad
Remove that first (./pack remove NAME; for the boosh prompt: ./install.sh --only prompt --prompt default). Nothing was changed."
}

# fisher plugins can react to being installed or removed (a conf.d function --on-event NAME_install / _update / _uninstall):
# do what fisher does, source the plugin's conf.d files in a clean fish and emit the event
fish_event() { # fish_event PLUGIN EVENT DIR
  local plugin="$1" ev="$2" d="$3" f files
  files=()
  if [ "$DRY" = 1 ] || ! have_cmd fish; then return 0; fi
  for f in "$d"/conf.d/*.fish; do
    [ -f "$f" ] || continue
    files[${#files[@]}]="$f"
  done
  [ ${#files[@]} -gt 0 ] || return 0
  fish --no-config -c 'set -l plugin $argv[1]; set -l ev $argv[2]; for f in $argv[3..-1]; source $f; end; emit "$plugin"_"$ev"' "$plugin" "$ev" "${files[@]}" </dev/null >/dev/null 2>&1 \
    || echo "warn    the ${plugin}_$ev handler of this plugin reported an error (ignored)"
  return 0
}

# ─── finding a pack: shipped here, in the catalog, or any source ────
PK_ARG=""; PK_KIND=""; PK_SPEC=""; PK_PLUGIN=""
resolve_arg() { # resolve_arg ARG : find the pack, downloading if needed. Sets PK_NAME PK_DIR PK_KIND PK_SPEC PK_PLUGIN
  local arg="$1" kind t base
  PK_ARG="$arg"; PK_NAME=""; PK_DIR=""; PK_KIND=""; PK_SPEC=""; PK_PLUGIN=""; FETCH_SHA=""
  kind="$(src_kind "$arg")"
  case "$kind" in
    bad) die "plain http:// is not allowed: use https://" ;;
    none)
      case "$arg" in ''|*[!a-z0-9_-]*) die "'$arg' is neither a pack name nor a source (OWNER/REPO, https://..., a folder)" ;; esac
      if [ "$REMOTE" != 1 ] && [ -f "$PACKS/$arg/pack.conf" ]; then
        PK_KIND=bundled; PK_DIR="$PACKS/$arg"; PK_SPEC="this repository"
      else
        catalog_load || die "pack '$arg' is not shipped here and the catalog could not be loaded (BOOSH_CATALOG, packs.conf)"
        [ -f "$CATALOG_DIR/$arg/pack.conf" ] || die "pack '$arg' is not in the catalog $(catalog_spec) (see: ./pack list --remote)"
        PK_KIND=catalog; PK_DIR="$CATALOG_DIR/$arg"; PK_SPEC="$(catalog_spec)"
      fi
      PK_NAME="$arg"; PK_PLUGIN="$arg" ;;
    *)
      t="$(mktemp -d "${TMPDIR:-/tmp}/boosh-src.XXXXXX")"; TMPS[${#TMPS[@]}]="$t"
      echo "fetch   $arg"
      fetch_into "$arg" "$t" || die "could not get '$arg'"
      base="${arg#github:}"; base="${base%%@*}"; base="$(basename "$(src_path "$base")")"
      PK_NAME="$(src_slug "$base")"; PK_PLUGIN="$(src_plugin_name "$base")"
      [ -n "$PK_NAME" ] || die "cannot derive a pack name from '$arg'"
      if [ ! -f "$t/pack.conf" ] && [ ! -f "$t/fish.fish" ] && [ ! -d "$t/conf.d" ] && [ ! -d "$t/functions" ] \
         && [ ! -d "$t/completions" ] && [ ! -d "$t/themes" ] && [ ! -f "$t/gitconfig" ]; then
        die "'$arg' has nothing to install: no pack.conf, fish.fish, conf.d/, functions/, completions/ or themes/ at its top level"
      fi
      PK_KIND=external; PK_DIR="$t"; PK_SPEC="$arg" ;;
  esac
}

trust_prompt() { # trust_prompt NAME DIR : third-party code runs in every fish session: show what it is and ask
  local name="$1" d="$2" t
  echo
  echo "Source:   $PK_SPEC${FETCH_SHA:+  (archive sha256 ${FETCH_SHA})}"
  echo "This is code from outside boosh. Once installed it runs in every new fish session"
  echo "(and a gitconfig in it changes git). It will add:"
  list_fish_dir "$d" "pack-$name" "  "
  [ ! -f "$d/gitconfig" ] || echo "  git    settings from its gitconfig"
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    echo "  tool   $(field "$t" 1): $(field "$t" 4)"
  done <<EOF
$(conf_tools "$name")
EOF
  echo "Read it first with: ./pack show $PK_ARG"
  if [ "$YES" = 1 ] || confirm "Install '$name' from $PK_SPEC?" n; then return 0; fi
  die "cancelled (nothing was changed). Use --yes to accept without the question."
}

write_meta() { # write_meta NAME : where an installed pack came from
  if [ "$DRY" = 1 ]; then return 0; fi
  { echo "arg=$PK_ARG"; echo "kind=$PK_KIND"; echo "plugin=$PK_PLUGIN"; echo "source=$PK_SPEC"
    echo "archive_sha256=${FETCH_SHA:-}"; echo "installed=$(date +%Y-%m-%d)"; } > "$BH_PACKS/$1/.source"
  return 0
}

# ─── commands ────────────────────────────────────────────
cmd_list() {
  local d name st x names kind
  catalog_load || echo "warn    the catalog is not available: only installed packs are listed"
  # every pack we know of: shipped here, in the catalog, installed
  names="$( {
      for d in "$PACKS"/*/; do if [ -f "${d}pack.conf" ]; then basename "$d"; fi; done
      if [ -n "$CATALOG_DIR" ]; then for d in "$CATALOG_DIR"/*/; do if [ -f "${d}pack.conf" ]; then basename "$d"; fi; done; fi
      if [ -f "$STATE" ]; then grep -v '[+~]' "$STATE" || true; fi
    } | sort -u || true )"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if is_installed "$name"; then st="installed"; else st="available"; fi
    printf '  %-12s %-10s %s\n' "$name" "$st" "$(conf_get "$name" DESCRIPTION)"
    kind="$(meta_get "$name" kind)"
    if [ "$kind" = external ]; then printf '  %-12s %-10s from %s\n' "" "" "$(meta_get "$name" source)"; fi
    for x in $(options_of "$name"); do
      printf '  %-12s %-10s --%s (%s, %s): %s\n' "" "" "$x" "$(opt_kind "$name" "$x")" "$(opt_state "$name" "$x")" "$(opt_desc "$name" "$x")"
    done
  done <<EOF
$names
EOF
  echo
  echo "catalog: $(catalog_spec)$(src_pinned "$(catalog_spec)" || echo ' (not pinned to a commit)')"
  echo "any GitHub plugin works too: ./pack add OWNER/REPO   (preview it first: ./pack show OWNER/REPO)"
}

cmd_show() {
  local arg="$1" name x P_DIR
  if [ "$(src_kind "$arg")" = none ] && [ "$REMOTE" != 1 ] && valid_name "$arg"; then
    name="$arg"
  else
    resolve_arg "$arg"; name="$PK_NAME"
  fi
  P_DIR="$(pdir "$name")"
  echo "$name: $(conf_get "$name" DESCRIPTION)"
  echo "status: $(is_installed "$name" && echo installed || echo available)"
  if [ "$name" = "$PK_NAME" ]; then echo "source: $PK_SPEC${FETCH_SHA:+ (archive sha256 $FETCH_SHA)}"
  elif [ -n "$(meta_get "$name" source)" ]; then echo "source: $(meta_get "$name" source)"; fi
  echo "files:"
  list_fish_dir "$P_DIR" "pack-$name" "  "
  [ ! -f "$P_DIR/gitconfig" ] || echo "  git    $GIT_DIR/pack-$name.conf (+ include.path in ~/.gitconfig)"
  for t in "$P_DIR"/gitconfig.*; do
    [ -f "$t" ] || continue
    echo "  git    $GIT_DIR/pack-$name-${t##*.}.conf (only while '${t##*.}' is installed)"
  done
  if [ -n "$(options_of "$name")" ]; then
    echo "options (./pack add $name --OPTION, ./pack remove $name --OPTION; in a terminal ./pack add $name offers them in a checklist):"
    for x in $(options_of "$name"); do
      printf '  --%-10s %-5s [%s]  %s\n' "$x" "$(opt_kind "$name" "$x")" "$(opt_state "$name" "$x")" "$(opt_desc "$name" "$x")"
      if is_extra "$name" "$x"; then list_fish_dir "$P_DIR/extras/$x" "pack-$name-$x" "        "
      elif [ "$(opt_state "$name" "$x")" != installed ]; then printf '        %s\n' "$(tool_via "$(tool_spec "$name" "$x")")"
      elif [ -n "$(tool_log_get "$name" "$x")" ]; then printf '        installed by pack: ./pack remove %s --purge-tools uninstalls it\n' "$name"; fi
    done
  fi
  if [ -f "$P_DIR/fish.fish" ]; then
    echo "abbreviations:"
    sed -n "s/^[[:space:]]*abbr -a \(--set-cursor \)\{0,1\}\([A-Za-z0-9_-]*\) \(.*\)$/  \2  =  \3/p" "$P_DIR/fish.fish" | sed "s/--set-cursor //; s/--function [A-Za-z0-9_]*/(computed when you press space)/"
  fi
  if [ -f "$P_DIR/gitconfig" ]; then
    echo "git settings it adds:"
    git_ok && git config -f "$P_DIR/gitconfig" --list | sed 's/^/  /' || echo "  (git not installed)"
  fi
  return 0
}

cmd_add() {
  local arg="$1" name t cmd f x suffix P_SRC P_DIR api was_installed=0 prev_arg prev_kind
  CHOSEN=""
  resolve_arg "$arg"
  name="$PK_NAME"; P_SRC="$PK_DIR"

  api=""; if [ -f "$P_SRC/pack.conf" ]; then api="$(sed -n 's/^API=//p' "$P_SRC/pack.conf" | head -n 1)"; fi
  if [ -n "$api" ]; then
    case "$api" in *[!0-9]*) die "pack '$name': API= in its pack.conf must be a number" ;; esac
    [ "$api" -le "$PACK_API" ] || die "pack '$name' needs a newer boosh (it speaks pack API $api, this one $PACK_API): update boosh first"
  fi
  if [ ${#EXTRAS[@]} -gt 0 ]; then
    for x in "${EXTRAS[@]}"; do
      is_option "$name" "$x" || die "'--$x' is not a flag, and pack '$name' has no option '$x' (see: ./pack show $arg)"
    done
  fi
  if is_installed "$name"; then
    was_installed=1
    prev_arg="$(meta_get "$name" arg)"; prev_kind="$(meta_get "$name" kind)"
    if [ -n "$prev_kind" ] && { [ "$prev_kind" = external ] || [ "$PK_KIND" = external ]; } && [ "$prev_arg" != "$PK_ARG" ]; then
      die "'$name' is already installed from '${prev_arg:-another source}': run ./pack remove $name first"
    fi
  elif [ "$PK_KIND" = external ] && { catalog_load 2>/dev/null || true; } && { [ -f "$PACKS/$name/pack.conf" ] || { [ -n "$CATALOG_DIR" ] && [ -f "$CATALOG_DIR/$name/pack.conf" ]; }; }; then
    die "the name '$name' belongs to a pack of boosh; rename the folder or the repository of '$arg' to install it"
  fi
  if [ "$PK_KIND" = external ] && [ "$(meta_get "$name" arg)" != "$PK_ARG" ]; then trust_prompt "$name" "$P_SRC"; fi
  choose_options "$name"
  preflight "$name" "$P_SRC"

  MF_NEW=()
  if [ "$was_installed" = 1 ]; then echo "== $name (already installed, re-applying)"; else echo "== $name"; fi

  # tools: the chosen ones are installed if missing, the rest are only mentioned (the list goes through fd 3 so stdin stays free)
  while IFS= read -r t <&3; do
    [ -n "$t" ] || continue
    cmd="$(field "$t" 1)"
    if chosen "$cmd" && [ "$OPT_NONE" != 1 ] && [ "$OPT_TOOLS" != none ]; then
      ensure_tool "$t"
      state_add "$name+$cmd"; state_del "$name~$cmd"
    elif have_cmd "$cmd"; then
      echo "have    $cmd (already installed)"
    else
      echo "skip    $cmd: $(field "$t" 4) (add it with: ./pack add $name --$cmd)"
    fi
  done 3<<EOF
$(conf_tools "$name")
EOF

  # the files the shell and git read live in a snapshot outside the repository, so a branch switch cannot break them
  P_DIR="$P_SRC"
  if [ "$DRY" = 0 ]; then
    mkdir -p "$BH_PACKS"; rm -rf "${BH_PACKS:?}/$name"; cp -R "$P_SRC" "$BH_PACKS/$name"; P_DIR="$BH_PACKS/$name"
    [ -f "$P_DIR/pack.conf" ] || echo "DESCRIPTION=plugin from $PK_SPEC" > "$P_DIR/pack.conf"
    write_meta "$name"
  fi

  link_fish_dir "$P_DIR" "pack-$name"
  # optional parts: the ones you asked for now, plus the ones installed earlier (so a plain re-add does not lose them)
  for x in $(extras_of "$name"); do
    if chosen "$x"; then
      echo "part    --$x: $(extra_desc "$name" "$x")"
      link_fish_dir "$P_DIR/extras/$x" "pack-$name-$x"
      state_add "$name+$x"
    fi
  done

  if [ -f "$P_DIR/gitconfig" ]; then
    if git_ok; then
      git_attach "$P_DIR/gitconfig" "pack-$name.conf"
      for f in "$P_DIR"/gitconfig.*; do
        [ -f "$f" ] || continue
        suffix="${f##*.}"
        if have_cmd "$suffix" && ! is_installed "$name~$suffix"; then
          git_attach "$f" "pack-$name-$suffix.conf"
        else
          # the tool is gone, was never installed, or was switched off (./pack remove NAME --TOOL): its config must not be active
          git_detach "pack-$name-$suffix.conf" "$name"
        fi
      done
    else
      echo "skip    git settings: git is not installed on this machine"
    fi
  fi

  state_add "$name"
  [ "$DRY" = 1 ] || mf_commit "pack:$name"
  if [ "$was_installed" = 1 ]; then fish_event "$PK_PLUGIN" update "$P_DIR"; else fish_event "$PK_PLUGIN" install "$P_DIR"; fi
  echo "done    $name. Open a new fish session (or: exec fish) to use it."
}

cmd_update() {
  local n arg names
  names=()
  if [ ${#NAMES[@]} -gt 0 ]; then names=("${NAMES[@]}")
  elif [ -f "$STATE" ]; then
    while IFS= read -r n; do
      case "$n" in ''|*+*|*~*) continue ;; esac
      names[${#names[@]}]="$n"
    done < "$STATE"
  fi
  if [ ${#names[@]} -eq 0 ]; then echo "no packs installed (see: ./pack list)"; return 0; fi
  for n in "${names[@]}"; do
    valid_name "$n" || die "no such pack: '$n' (see: ./pack list)"
    is_installed "$n" || die "'$n' is not installed (./pack add $n)"
    arg="$(meta_get "$n" arg)"
    cmd_add "${arg:-$n}"
  done
}

cmd_remove() {
  local name="$1" f x suffix P_DIR plugin
  need_pack "$name"
  P_DIR="$(pdir "$name")"
  if [ ${#EXTRAS[@]} -gt 0 ]; then   # only the named options
    for x in "${EXTRAS[@]}"; do
      echo "== remove $name --$x"
      if is_extra "$name" "$x"; then
        unlink_fish_dir "$P_DIR/extras/$x" "pack-$name-$x" "$name"
        state_del "$name+$x"
        echo "done    --$x removed; the rest of $name stays."
      else
        # a tool: switch it off for this pack; the program is offered for uninstalling only if pack installed it
        state_del "$name+$x"; state_add "$name~$x"
        if [ -f "$P_DIR/gitconfig.$x" ]; then git_detach "pack-$name-$x.conf" "$name"; fi
        echo "done    --$x is off for $name (its git settings are detached)."
        remove_tools "$name" "$x"
        if [ -z "$(tool_log_get "$name" "$x")" ] && have_cmd "$x"; then echo "note    the program $x stays on your machine (pack did not install it)."; fi
      fi
    done
    return 0
  fi
  echo "== remove $name"
  plugin="$(meta_get "$name" plugin)"
  fish_event "${plugin:-$name}" uninstall "$P_DIR"
  unlink_fish_dir "$P_DIR" "pack-$name" "$name"
  for x in $(extras_of "$name"); do unlink_fish_dir "$P_DIR/extras/$x" "pack-$name-$x" "$name"; done
  for x in $(options_of "$name"); do state_del "$name+$x"; state_del "$name~$x"; done
  if [ -f "$P_DIR/gitconfig" ]; then
    git_detach "pack-$name.conf" "$name"
    for f in "$P_DIR"/gitconfig.*; do
      [ -f "$f" ] || continue
      git_detach "pack-$name-${f##*.}.conf" "$name"
    done
  fi
  [ "$DRY" = 1 ] || { rm -rf "${BH_PACKS:?}/$name"; mf_forget "pack:$name"; }
  state_del "$name"
  remove_tools "$name"
  echo "done    $name removed. Programs that were on your machine before are never touched."
}

cmd_status() {
  local name f x suffix bad=0 pbad inst=0 P_DIR
  for name in $( [ -f "$STATE" ] && cat "$STATE" || true ); do
    case "$name" in *+*|*~*) continue ;; esac   # an option: checked together with its pack
    valid_name "$name" || { echo "WARN  $name: in the state file, but neither in the repository nor installed"; bad=1; continue; }
    inst=1; pbad=0
    P_DIR="$(pdir "$name")"
    check_fish_dir "$P_DIR" "pack-$name" "$name" || pbad=1
    for x in $(extras_of "$name"); do
      if is_installed "$name+$x"; then check_fish_dir "$P_DIR/extras/$x" "pack-$name-$x" "$name --$x" || pbad=1; fi
    done
    if [ -f "$P_DIR/gitconfig" ] && git_ok; then
      git_include_has "~/.config/git/pack-$name.conf" || { echo "WARN  $name: git include for pack-$name.conf is missing (run: ./pack add $name)"; pbad=1; }
      for f in "$P_DIR"/gitconfig.*; do
        [ -f "$f" ] || continue
        suffix="${f##*.}"
        if git_include_has "~/.config/git/pack-$name-$suffix.conf" && ! have_cmd "$suffix"; then
          echo "WARN  $name: git is set to use '$suffix' but it is not on PATH, so git commands that page output will fail."
          echo "      fix: install $suffix or put it on PATH, or run './pack add $name' (it switches that config off)"
          pbad=1
        fi
      done
    fi
    if [ "$pbad" = 1 ]; then bad=1; else echo "ok    $name"; fi
  done
  [ "$inst" = 1 ] || echo "no packs installed (see: ./pack list)"
  [ "$bad" = 0 ]
}

case "$CMD" in
  list)   cmd_list ;;
  status) cmd_status ;;
  show)   [ ${#NAMES[@]} -gt 0 ] || die "usage: ./pack show NAME|SOURCE"; cmd_show "${NAMES[0]}" ;;
  add)    [ ${#NAMES[@]} -gt 0 ] || die "usage: ./pack add NAME|SOURCE... [--PART]"; for n in "${NAMES[@]}"; do cmd_add "$n"; done ;;
  update) cmd_update ;;
  remove) [ ${#NAMES[@]} -gt 0 ] || die "usage: ./pack remove NAME... [--PART]"; check_parts "${NAMES[@]}"; for n in "${NAMES[@]}"; do cmd_remove "$n"; done ;;
  *) usage >&2; die "unknown command: $CMD" ;;
esac
